# Copy to .env and fill in your own keys. Never commit .env.
# All traffic from this server goes only to the providers you configure below
# plus the source URLs returned by search. Nothing is sent to the repo author.

# --- JEV / TypeSafe (required for live semantic filtering) ---
# Get a key from the TypeSafe dashboard. SDK default env name is TYPESAFE_API_KEY.
TYPESAFE_API_KEY=
# Optional model override (default: jev-latest)
TYPESAFE_MODEL=jev-latest

# --- Search provider (live only: Brave Search) ---
# Get a key from https://brave.com/search/api/
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
# Generic fallback if BRAVE_API_KEY is unset:
# SEARCH_API_KEY=

# --- HTTP / fetch limits ---
FETCH_TIMEOUT_SECONDS=15.0
MAX_RESPONSE_BYTES=2000000
MAX_REDIRECTS=5
MAX_DOCUMENT_CHARS=200000
MAX_CONCURRENT_FETCHES=5

# --- Search limits ---
MAX_SEARCH_RESULTS=20

# --- JEV batching ---
JEV_RESULT_BATCH_SIZE=20
JEV_BLOCK_BATCH_SIZE=30
JEV_MAX_STATE_CHARS=80000
JEV_MAX_BLOCK_CHARS_FOR_STATE=2000
MAX_BLOCKS_PER_DOCUMENT=300

# --- Selection thresholds (Noul probabilities in [0,1]) ---
RESULT_RELEVANT_THRESHOLD=0.5
RESULT_USEFUL_THRESHOLD=0.5
RESULT_UNCERTAIN_MARGIN=0.15
BLOCK_RELEVANT_THRESHOLD=0.5
BLOCK_ACTIONABLE_THRESHOLD=0.5
BLOCK_UNCERTAIN_MARGIN=0.15

# --- Evidence budget (estimated tokens; approximation = chars/4) ---
MAX_EVIDENCE_TOKENS=8000
MAX_SOURCES=10

# --- Cache / logging ---
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
LOG_LEVEL=INFO

# --- Local dashboard (visualizes pipeline + context cut on localhost) ---
# Started automatically with `python -m jev_research_mcp` (stdout stays clean for MCP).
ENABLE_UI=true
UI_HOST=127.0.0.1
UI_PORT=8765
# Set true to also pop the dashboard in a browser on startup:
# UI_OPEN_BROWSER=false
